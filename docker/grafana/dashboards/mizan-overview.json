{
  "uid": "mizan-overview",
  "title": "Mizan — overview",
  "description": "Story 6.1: analyses, model tokens, caps, API latency, Kafka lag, errors and recent traces. Source: docker/grafana (edit there, not in the UI).",
  "tags": ["mizan"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Analyses per hour by outcome",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(mizan_analysis_outcomes_total[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Model tokens per hour",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (increase(mizan_analysis_tokens_total[1h]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Global daily cap used",
      "description": "Alert above 80 %.",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "max(mizan_quota_global_used) / max(mizan_quota_global_cap)" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API p95 latency by route (SSE excluded)",
      "description": "Alert when the overall p95 stays above 1 s for 10 min.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_milliseconds_bucket{service_name=\"mizan-api\", uri!~\".*/events\"}[5m])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API requests per second by status",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_name=\"mizan-api\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka consumer lag (records, worst partition)",
      "description": "Alert above 50 for 10 min. A stopped consumer shows no line, not a growing one.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service_name) (kafka_consumer_fetch_manager_records_lag{service_name=~\"mizan-.*\"})",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent upload traces",
      "description": "Click a trace id: browser → mizan-api → Kafka → mizan-analyzer → model → apply.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"mizan-api\" && name=\"http post /api/v1/contracts\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "ERROR logs (alert above 5 in 5 min)",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"mizan-api|mizan-analyzer\"} | severity_text=\"ERROR\""
        }
      ]
    }
  ]
}

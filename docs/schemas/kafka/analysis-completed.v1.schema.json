{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "type" : "object",
  "properties" : {
    "analysisId" : {
      "type" : "string",
      "format" : "uuid"
    },
    "contractId" : {
      "type" : "string",
      "format" : "uuid"
    },
    "flags" : {
      "type" : "array",
      "items" : {
        "type" : "object",
        "properties" : {
          "clauseText" : {
            "type" : "string"
          },
          "explanation" : {
            "type" : "string"
          },
          "riskLevel" : {
            "type" : "string",
            "enum" : [ "LOW", "MEDIUM", "HIGH" ]
          },
          "suggestedCorrection" : {
            "type" : "string"
          }
        },
        "additionalProperties" : false
      }
    },
    "inputTokens" : {
      "type" : "integer"
    },
    "model" : {
      "type" : "string"
    },
    "outputTokens" : {
      "type" : "integer"
    },
    "schemaVersion" : {
      "type" : "integer"
    },
    "summary" : {
      "type" : "string"
    }
  },
  "additionalProperties" : false
}

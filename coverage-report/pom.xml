<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ma.mizan</groupId>
    <artifactId>mizan-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>coverage-report</artifactId>
  <packaging>pom</packaging>
  <name>Mizan Coverage Report</name>
  <description>Aggregates JaCoCo coverage of all backend modules into target/site/jacoco-aggregate.</description>

  <dependencies>
    <dependency>
      <groupId>ma.mizan</groupId>
      <artifactId>mizan-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ma.mizan</groupId>
      <artifactId>mizan-analyzer</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        This module only aggregates reports. It puts mizan-api and mizan-analyzer on one artificial
        classpath they never share at run time (separate deployables), so dependency convergence is
        checked in each app module instead; Java and Maven version rules still apply here.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-rules</id>
            <configuration>
              <rules combine.self="override">
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

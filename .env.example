# Copy to .env (git-ignored) and adjust. Values below are for a local machine only.

# --- PostgreSQL (database "mizan") ---
POSTGRES_PASSWORD=postgres
MIZAN_DB_PASSWORD=mizan
KEYCLOAK_DB_PASSWORD=keycloak

# --- Keycloak admin console ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- API database (mizan-api, IDE runs; compose sets its own in-network URL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/mizan
SPRING_DATASOURCE_USERNAME=mizan_app
SPRING_DATASOURCE_PASSWORD=mizan

# --- API security (mizan-api) ---
# Issuer as the browser sees Keycloak; the JWK set URI may differ (compose uses keycloak:8080).
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/mizan
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/mizan/protocol/openid-connect/certs
MIZAN_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Quota (FR-8) and uploads ---
MIZAN_QUOTA_DAILY_PER_USER=3
MIZAN_UPLOADS_PER_MINUTE=10
# ClamAV daemon host; empty = uploads are NOT virus-scanned (warning at start-up).
# With the compose "av" profile use: MIZAN_CLAMAV_HOST=clamav
MIZAN_CLAMAV_HOST=

# --- Anthropic (mizan-analyzer, Sprint 3) ---
# Real key goes in .env only. Tests use a stub model and never need it.
ANTHROPIC_API_KEY=
# Model id; Opus 5.5 always thinks (billed as output) - no temperature (API rejects it since 2026-10-21).
MIZAN_AI_MODEL=claude-opus-5-5
MIZAN_AI_MAX_TOKENS=16000
# Per-user daily model spend (mizan-api refuses uploads beyond it) and the model's prices.
MIZAN_AI_DAILY_BUDGET_USD=0.50
MIZAN_AI_INPUT_USD_PER_MTOK=4
MIZAN_AI_OUTPUT_USD_PER_MTOK=20

# --- Host ports (change if something else already uses them) ---
POSTGRES_PORT=5435
KAFKA_PORT=9092
KEYCLOAK_PORT=8180
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MAILPIT_UI_PORT=8025
API_PORT=8080

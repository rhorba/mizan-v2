# Copy to .env (git-ignored) and adjust. Values below are for a local machine only.

# --- PostgreSQL (database "mizan") ---
POSTGRES_PASSWORD=postgres
MIZAN_DB_PASSWORD=mizan
KEYCLOAK_DB_PASSWORD=keycloak

# --- Keycloak admin console ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- API security (mizan-api) ---
# Issuer as the browser sees Keycloak; the JWK set URI may differ (compose uses keycloak:8080).
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/mizan
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/mizan/protocol/openid-connect/certs
MIZAN_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Quota (FR-8) ---
MIZAN_QUOTA_DAILY_PER_USER=3

# --- Anthropic (needed from Sprint 3; leave empty until then) ---
ANTHROPIC_API_KEY=

# --- Host ports (change if something else already uses them) ---
POSTGRES_PORT=5435
KAFKA_PORT=9092
KEYCLOAK_PORT=8180
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MAILPIT_UI_PORT=8025
API_PORT=8080
